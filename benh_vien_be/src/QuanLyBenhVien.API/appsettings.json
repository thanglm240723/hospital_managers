{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": { "MigrateOnStartup": false },
  "Seed": { "AdminEmail": "", "AdminPassword": "", "AdminFullName": "Quản trị hệ thống" },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=QuanLyBenhVienDb;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "http://localhost:5289",
    "Audience": "hospital-management",
    "AccessTokenMinutes": 15,
    "SigningKey": ""
  },
  "Auth": {
    "AllowedOrigins": [ "http://localhost:9000" ],
    "CsrfKey": "",
    "InternalApiKey": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}" } },
      { "Name": "File", "Args": { "path": "logs/api-.json", "rollingInterval": "Day", "retainedFileCountLimit": 14, "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Service": "api" }
  }
}
